{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard-publish.sh", "timeout": 10 },
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard-default-branch.sh", "timeout": 10 },
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/lint-warn.sh", "timeout": 60 },
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/test-gate.sh", "timeout": 600 }
        ]
      }
    ]
  }
}
