{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard-publish.sh", "timeout": 10 },
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/allow-gh-api-read.sh", "timeout": 10 },
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard-default-branch.sh", "timeout": 10 },
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/lint-warn.sh", "timeout": 60 },
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/test-gate.sh", "timeout": 600 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/comment-warn.sh", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/findings-gate.sh", "timeout": 10 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/findings-capture.sh", "timeout": 10 }
        ]
      },
      {
        "matcher": "architect|data-engineer|qa-engineer|release-engineer|sre|security-engineer|technical-writer",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/persona-report.sh", "timeout": 10 }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/post-merge-cleanup.sh", "timeout": 20 },
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/lessons-nudge.sh", "timeout": 10 }
        ]
      }
    ]
  }
}
